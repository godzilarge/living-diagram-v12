{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@engine/*": [
        "../engine/src/*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ],
      "lucide-react": [
        "./node_modules/lucide-react"
      ],
      "@xyflow/react": [
        "./node_modules/@xyflow/react"
      ],
      "i18next": [
        "./node_modules/i18next"
      ],
      "react-i18next": [
        "./node_modules/react-i18next"
      ],
      "prismjs/*": [
        "./node_modules/prismjs/*"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "e2e",
    "scripts",
    "vite.config.ts",
    "playwright.config.ts",
    "../engine/src/app/code/prism-types.d.ts"
  ]
}

{
  "name": "ld-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Living Diagram — la toile : moteur de diagramme TypeScript pur, zéro framework, construit en un seul fichier embarqué par le backend",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --noEmit && node build.mjs --check && node types.mjs --check && node strings.mjs --check",
    "types": "node types.mjs",
    "typecheck": "tsc --noEmit",
    "strings": "node strings.mjs"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/cascadia-mono": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/source-code-pro": "5.3.0",
    "@xyflow/react": "12.12.0",
    "i18next": "26.4.2",
    "lucide-react": "1.52.0",
    "prismjs": "1.30.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "17.0.14"
  }
}

{
  "name": "ld-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Living Diagram — la toile : moteur de diagramme TypeScript pur, zéro framework, construit en un seul fichier embarqué par le backend",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --noEmit && node build.mjs --check && node types.mjs --check && node strings.mjs --check",
    "types": "node types.mjs",
    "typecheck": "tsc --noEmit",
    "strings": "node strings.mjs"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/cascadia-mono": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/source-code-pro": "5.3.0",
    "@xyflow/react": "12.12.0",
    "i18next": "26.4.2",
    "lucide-react": "1.52.0",
    "prismjs": "1.30.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "17.0.14"
  },
  "overrides": {
    "@lezer/common": "1.5.3",
    "@lezer/highlight": "1.2.5",
    "@lezer/lr": "1.4.10",
    "style-mod": "4.1.4",
    "w3c-keyname": "2.2.8",
    "crelt": "1.0.7",
    "@marijn/find-cluster-break": "1.0.4"
  }
}
